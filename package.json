{
  "name": "seclip",
  "version": "0.1.0",
  "description": "End-to-end encrypted clipboard CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "seclip": "dist/cli/seclip.js"
  },
  "files": [
    "dist/cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "frontend/src/lib/my-marked"
  ],
  "scripts": {
    "check": "tsc -p frontend/tsconfig.json --watch & tsc -p backend/tsconfig.json --watch",
    "build": "vite build frontend --watch",
    "build:cli": "vite build -c vite.cli.config.ts",
    "prepublishOnly": "tsc -p frontend/tsconfig.json --noEmit && tsc -p backend/tsconfig.json --noEmit && npm run build:cli",
    "worker": "wrangler dev --config backend/wrangler.toml --env-file \"$PWD/.env\" --port 3000 --ip 0.0.0.0",
    "deploy": "sh scripts/deploy.sh",
    "test": "deno test --allow-net=localhost:3000"
  },
  "dependencies": {
    "qr": "^0.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^26.6.10",
    "lucide-static": "^1.80.0",
    "rollup-plugin-license": "^3.7.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  }
}
